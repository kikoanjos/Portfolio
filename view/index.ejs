                    <form id="contactForm">
                        <div class="input-group">
                            <input type="text" id="firstname" placeholder="Firstname" required>
                            <input type="text" id="lastname" placeholder="Lastname" required>
                        </div>
                        <div class="input-group">
                            <input type="email" id="email" placeholder="Email address" required>
                            <input type="tel" id="phone" placeholder="Phone number" required>
                        </div>
                        <select id="service" required>
                            <option value="" disabled selected>Select a service</option>
                            <option value="Eletronics Technician">Eletronics Technician</option>
                            <option value="Informatic Engineer">Informatic Engineer</option>
                            <option value="other">Other</option>
                        </select>
                        <textarea id="message" placeholder="Type your message here." rows="4" maxlength="240" required></textarea>
                        <div class="char-counter" id="charCounter">0/240</div>
                        <button type="submit">Send message</button>
                    </form>
